# Copy to .env and fill in real values. NEVER commit .env.

# Google Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY="your-key-here"

# Model tiers. Per-node routing maps each graph node to one of these (see plan.md §5).
# Default / high-volume tier (classify, explain).
GEMINI_MODEL="gemini-3.5-flash-lite"
# Core execution tier (generate, repair, optimize).
GEMINI_MODEL_CORE="gemini-3.8-flash"
# Complex synthesis tier (reserved, opt-in — tight free-tier caps).
GEMINI_MODEL_PRO="gemini-3.8-flash"

# App
ENVIRONMENT="development"
LOG_LEVEL="info"
